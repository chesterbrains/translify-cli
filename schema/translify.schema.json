{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://unpkg.com/@chesterbrains/translify-cli/schema/translify.schema.json",
  "title": "translify.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiUrl", "files"],
  "properties": {
    "$schema": { "type": "string" },
    "apiUrl": { "type": "string", "format": "uri" },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["pattern", "format"],
        "properties": {
          "pattern": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\{locale\\}",
            "description": "Path with {locale} and optionally {namespace}, using / separators."
          },
          "format": { "enum": ["json", "xliff", "arb", "android", "strings", "stringsdict"] },
          "namespace": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$",
            "maxLength": 64,
            "description": "Fixed namespace. Required when the pattern has no {namespace}, and always for arb, android, strings and stringsdict."
          },
          "jsonStyle": { "enum": ["nested", "flat"], "description": "Only for format json. Defaults to nested." },
          "xliffDialect": {
            "enum": ["angular", "xcode"],
            "description": "Only for format xliff. angular writes @angular/localize placeholders (<ph equiv=\"INTERPOLATION\"/>, VAR_PLURAL) on pull and reads ng extract-i18n output on push. xcode writes XLIFF 1.2 for String Catalogs (positional printf, |==| plural and substitution units) and reads xcodebuild -exportLocalizations output."
          },
          "xliffOriginal": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "description": "Only with xliffDialect xcode, and required with it: the String Catalog path Xcode knows (e.g. Sources/App/Localizable.xcstrings), written to <file original>. Xcode imports nothing when it does not match."
          }
        },
        "allOf": [
          {
            "if": { "properties": { "format": { "enum": ["arb", "android", "strings", "stringsdict"] } }, "required": ["format"] },
            "then": { "required": ["namespace"] }
          },
          {
            "if": { "properties": { "pattern": { "not": { "pattern": "\\{namespace\\}" } } }, "required": ["pattern"] },
            "then": { "required": ["namespace"] }
          },
          {
            "if": { "properties": { "format": { "enum": ["strings", "stringsdict"] } }, "required": ["format"] },
            "then": { "properties": { "pattern": { "not": { "pattern": "\\{namespace\\}" } } } }
          },
          {
            "if": { "properties": { "format": { "enum": ["xliff", "arb", "android", "strings", "stringsdict"] } }, "required": ["format"] },
            "then": { "not": { "required": ["jsonStyle"] } }
          },
          {
            "if": { "properties": { "format": { "enum": ["json", "arb", "android", "strings", "stringsdict"] } }, "required": ["format"] },
            "then": { "not": { "required": ["xliffDialect"] } }
          },
          {
            "if": { "properties": { "xliffDialect": { "const": "xcode" } }, "required": ["xliffDialect"] },
            "then": { "required": ["xliffOriginal"] },
            "else": { "not": { "required": ["xliffOriginal"] } }
          }
        ]
      }
    },
    "locales": {
      "type": "object",
      "description": "Maps a filesystem locale (en_US) to a Translify code (en-US). Unmapped locales pass through.",
      "additionalProperties": { "type": "string", "pattern": "^[A-Za-z]{2,3}(-[A-Za-z0-9]{2,8})*$" }
    }
  }
}
